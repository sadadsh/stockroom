<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AssemblyName>Stockroom.CadConverter</AssemblyName>
    <RootNamespace>Stockroom.CadConverter</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AltiumSharpRoot Condition="'$(AltiumSharpRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\vendor\AltiumSharp</AltiumSharpRoot>
  </PropertyGroup>

  <Target Name="RequireAltiumSharpSource" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(AltiumSharpRoot)\src\OriginalCircuit.Altium\OriginalCircuit.Altium.csproj')"
      Text="Initialize the pinned vendor\AltiumSharp submodule and its OriginalCircuit.Eda.Abstractions dependency." />
    <Error
      Condition="!Exists('$(AltiumSharpRoot)\shared\OriginalCircuit.Eda.Abstractions\src\OriginalCircuit.Eda.Abstractions\OriginalCircuit.Eda.Abstractions.csproj')"
      Text="Initialize AltiumSharp's pinned OriginalCircuit.Eda.Abstractions submodule." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(AltiumSharpRoot)\src\OriginalCircuit.Altium\OriginalCircuit.Altium.csproj" />
    <ProjectReference Include="$(AltiumSharpRoot)\src\OriginalCircuit.Altium.Rendering.Svg\OriginalCircuit.Altium.Rendering.Svg.csproj" />
    <ProjectReference Include="$(AltiumSharpRoot)\shared\OriginalCircuit.Eda.Abstractions\src\OriginalCircuit.Eda.Abstractions\OriginalCircuit.Eda.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="Assets\Altium PcbLib Template.PcbLib"
      LogicalName="Stockroom.CadConverter.AltiumPcbLibTemplate" />
  </ItemGroup>
</Project>
